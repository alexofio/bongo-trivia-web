{
  // Bongo Trivia player website. Serves public/ and owns bongotrivia.co.tz.
  // /bongo-trivia/* is forwarded to the Bluetrain Portal (PORTAL binding), which holds the game back end and its D1
  // "bongo-trivia". /r/* turns agent links into ?ref= for the app. See INTEGRATION.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bongo-trivia-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-13",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "bongotrivia.co.tz", "custom_domain": true },
    { "pattern": "www.bongotrivia.co.tz", "custom_domain": true }
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/bongo-trivia/*", "/r/*"]
  },
  // The portal Worker must exist (it does: bluetrain-portal). Remove bongotrivia.co.tz from the portal's custom domains
  // before the first deploy of this Worker, or the deploy reports the domain as taken.
  "services": [{ "binding": "PORTAL", "service": "bluetrain-portal" }]
}
